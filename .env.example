# ==============================================================================
# BionicText Environment Variables Configuration
# Copy this file to .env or configure in your deployment settings
# ==============================================================================

# AI API KEY (Server-Side Only for AI Assistant, Translations, Tests & Vision)
# NOTE: The variable name stays GROQ_API_KEY for compatibility, but the value is now a
# GOOGLE GEMINI API key. Get yours at: https://aistudio.google.com/apikey
GROQ_API_KEY=

# OPTIONAL: force a specific Gemini model (default: gemini-3.5-flash with automatic fallbacks)
# GEMINI_MODEL=gemini-3.5-flash

# SUPABASE CONFIGURATION (Database, Auth, Settings & History)
# Get these from your Supabase Project Settings -> API (https://supabase.com/dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
